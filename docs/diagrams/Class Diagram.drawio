        <mxCell id="h-title" value="H.264 Annex B 解析子系统" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="h1">
          <mxGeometry x="550" y="35" width="1000" height="45" as="geometry" />
        </mxCell>
        <mxCell id="h-subtitle" value="独立页面减少跨层连线；当前属于实验模块，尚未接入 AI 推理主链路" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#6b7280;" vertex="1" parent="h1">
          <mxGeometry x="550" y="80" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h-runtime-band" value="在线流式路径（Connection + Buffer）" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=16;opacity=28;" vertex="1" parent="h1">
          <mxGeometry x="80" y="150" width="750" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="h-parser-band" value="H.264 解析组件" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=16;opacity=28;" vertex="1" parent="h1">
          <mxGeometry x="900" y="150" width="1120" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="h-connection" value="&lt;b style=&quot;font-size:18px&quot;&gt;Connection&lt;/b&gt;&lt;br&gt;&amp;lt;&amp;lt;核心页对象&amp;gt;&amp;gt;&lt;hr&gt;+ processH264Nalus()&lt;br&gt;- inputBuffer : Buffer*&lt;br&gt;&lt;br&gt;连续切分 NALU&lt;br&gt;处理粘包、半包和阈值熔断" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="h1">
          <mxGeometry x="190" y="260" width="500" height="260" as="geometry" />
        </mxCell>
        <mxCell id="h-buffer" value="&lt;b style=&quot;font-size:18px&quot;&gt;Buffer&lt;/b&gt;&lt;br&gt;&amp;lt;&amp;lt;核心页对象&amp;gt;&amp;gt;&lt;hr&gt;+ findH264StartCode(start)&lt;br&gt;+ readableBytes() / retrieve()&lt;br&gt;+ peek() / beginWrite()&lt;br&gt;&lt;br&gt;持有 TCP 流式数据" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="h1">
          <mxGeometry x="190" y="720" width="500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="h-demuxer" value="&lt;b style=&quot;font-size:18px&quot;&gt;H264Demuxer&lt;/b&gt;&lt;hr&gt;- vector&amp;lt;uint8_t&amp;gt; streamData_&lt;br&gt;- int readIndex_&lt;hr&gt;+ getNextNalu() : NaluUnit&lt;br&gt;- dataBegin() / dataEnd()&lt;br&gt;&lt;br&gt;离线完整流解析（拷贝模式）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=14;" vertex="1" parent="h1">
          <mxGeometry x="1010" y="250" width="390" height="280" as="geometry" />
        </mxCell>
        <mxCell id="h-unit" value="&lt;b style=&quot;font-size:18px&quot;&gt;NaluUnit&lt;/b&gt;&lt;br&gt;&amp;lt;&amp;lt;struct&amp;gt;&amp;gt;&lt;hr&gt;+ vector&amp;lt;uint8_t&amp;gt; payload&lt;br&gt;+ int type&lt;br&gt;+ isEmpty()&lt;br&gt;&lt;br&gt;拥有 NALU 数据副本" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=14;" vertex="1" parent="h1">
          <mxGeometry x="1550" y="250" width="330" height="240" as="geometry" />
        </mxCell>
        <mxCell id="h-functions" value="&lt;b style=&quot;font-size:18px&quot;&gt;&amp;lt;&amp;lt;free functions&amp;gt;&amp;gt;&lt;/b&gt;&lt;hr&gt;+ findH264StartCode(start, end)&lt;br&gt;+ getNaluType(firstByte)&lt;br&gt;&lt;br&gt;Buffer 与 H264Demuxer 共享&lt;br&gt;无状态、零拷贝搜索" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=14;" vertex="1" parent="h1">
          <mxGeometry x="1010" y="730" width="410" height="250" as="geometry" />
        </mxCell>
        <mxCell id="h-view" value="&lt;b style=&quot;font-size:18px&quot;&gt;NaluView&lt;/b&gt;&lt;br&gt;&amp;lt;&amp;lt;struct&amp;gt;&amp;gt;&lt;hr&gt;+ const uint8_t* data&lt;br&gt;+ size_t size&lt;br&gt;+ int type&lt;br&gt;+ valid()&lt;br&gt;&lt;br&gt;不拥有底层数据" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=14;" vertex="1" parent="h1">
          <mxGeometry x="1550" y="730" width="330" height="250" as="geometry" />
        </mxCell>
